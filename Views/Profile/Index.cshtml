@model ONEE_Stage.Models.ViewModels.StudentProfileViewModel

@{
    ViewData["Title"] = "Mon Profil - Portail ONEE";
}

<div class="flex flex-col w-full bg-[#faf8ff] min-h-screen py-10">
    <div class="max-w-[1000px] mx-auto px-4 md:px-8 w-full">

        <form asp-controller="Profile" asp-action="Update" method="post" enctype="multipart/form-data" class="space-y-8">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="StudentId" />

            <!-- Section 1: Informations Personnelles -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8">
                <div class="flex items-center gap-2 mb-6 border-b border-gray-100 pb-4">
                    <span class="material-symbols-outlined text-[#0061a7] text-[24px]">account_circle</span>
                    <h2 class="text-lg font-bold text-[#001e40]">Informations Personnelles</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="FullName" class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Nom & Prénom *</label>
                        <input asp-for="FullName" class="w-full px-4 py-3 bg-[#f2f3ff] rounded-xl text-sm font-bold text-[#001e40] border border-transparent focus:bg-white focus:border-[#0061a7] outline-none transition-all" />
                    </div>

                    <div>
                        <label asp-for="Email" class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Adresse Email (Compte)</label>
                        <input asp-for="Email" readonly class="w-full px-4 py-3 bg-gray-50 rounded-xl text-sm font-bold text-gray-500 border border-gray-200 cursor-not-allowed" />
                    </div>

                    <div>
                        <label asp-for="Phone" class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Téléphone *</label>
                        <input asp-for="Phone" class="w-full px-4 py-3 bg-[#f2f3ff] rounded-xl text-sm font-bold text-[#001e40] border border-transparent focus:bg-white focus:border-[#0061a7] outline-none transition-all" />
                    </div>

                    <div>
                        <label asp-for="University" class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Établissement / École *</label>
                        <input asp-for="University" class="w-full px-4 py-3 bg-[#f2f3ff] rounded-xl text-sm font-bold text-[#001e40] border border-transparent focus:bg-white focus:border-[#0061a7] outline-none transition-all" />
                    </div>

                    <div class="md:col-span-2">
                        <label asp-for="Specialization" class="block text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">Spécialité / Option</label>
                        <input asp-for="Specialization" class="w-full px-4 py-3 bg-[#f2f3ff] rounded-xl text-sm font-bold text-[#001e40] border border-transparent focus:bg-white focus:border-[#0061a7] outline-none transition-all" placeholder="Génie Informatique, Electrique..." />
                    </div>
                </div>
            </div>

            <!-- Section 2: Documents de Candidature (CV & Lettre) -->
            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 md:p-8">
                <div class="mb-6 border-b border-gray-100 pb-4">
                    <h2 class="text-lg font-bold text-[#001e40] flex items-center gap-2">
                        <span class="material-symbols-outlined text-[#0061a7]">folder_open</span>
                        <span>Documents de Candidature</span>
                    </h2>
                    <p class="text-xs text-gray-400 mt-1">Téléversez vos documents par défaut au format PDF. Ils seront automatiquement joints lors de vos postulations aux offres ONEE.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- CV Card -->
                    <div class="p-5 rounded-2xl bg-[#faf8ff] border border-gray-100 flex flex-col justify-between gap-4">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-xs font-bold text-[#001e40] flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[#0061a7] text-[18px]">description</span>
                                    Curriculum Vitae (CV)
                                </span>
                                <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-red-100 text-red-700 uppercase">Requis</span>
                            </div>

                            @if (Model.CvDocumentId.HasValue && !string.IsNullOrEmpty(Model.CvFileName))
                            {
                                <div class="p-3 bg-white border border-emerald-200 rounded-xl flex items-center justify-between">
                                    <div class="flex items-center gap-2 truncate">
                                        <span class="material-symbols-outlined text-emerald-600 text-[20px]">picture_as_pdf</span>
                                        <span class="text-xs font-bold text-[#001e40] truncate">@Model.CvFileName</span>
                                    </div>
                                    <a asp-controller="Documents" asp-action="Preview" asp-route-id="@Model.CvDocumentId" target="_blank" class="p-1 text-[#0061a7] hover:text-[#001e40]">
                                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                                    </a>
                                </div>
                            }
                            else
                            {
                                <p class="text-xs text-gray-400 italic">Aucun CV téléversé.</p>
                            }
                        </div>

                        <div>
                            <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Remplacer / Ajouter un CV</label>
                            <input asp-for="CvFile" type="file" accept="application/pdf" class="block w-full text-xs text-gray-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-[#001e40] file:text-white hover:file:bg-[#0061a7] file:cursor-pointer transition-all" />
                        </div>
                    </div>

                    <!-- Cover Letter Card -->
                    <div class="p-5 rounded-2xl bg-[#faf8ff] border border-gray-100 flex flex-col justify-between gap-4">
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-xs font-bold text-[#001e40] flex items-center gap-1.5">
                                    <span class="material-symbols-outlined text-[#0061a7] text-[18px]">mark_email_read</span>
                                    Lettre de Motivation
                                </span>
                                <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-gray-100 text-gray-600 uppercase">Optionnel</span>
                            </div>

                            @if (Model.CoverLetterDocumentId.HasValue && !string.IsNullOrEmpty(Model.CoverLetterFileName))
                            {
                                <div class="p-3 bg-white border border-emerald-200 rounded-xl flex items-center justify-between">
                                    <div class="flex items-center gap-2 truncate">
                                        <span class="material-symbols-outlined text-emerald-600 text-[20px]">description</span>
                                        <span class="text-xs font-bold text-[#001e40] truncate">@Model.CoverLetterFileName</span>
                                    </div>
                                    <a asp-controller="Documents" asp-action="Preview" asp-route-id="@Model.CoverLetterDocumentId" target="_blank" class="p-1 text-[#0061a7] hover:text-[#001e40]">
                                        <span class="material-symbols-outlined text-[18px]">visibility</span>
                                    </a>
                                </div>
                            }
                            else
                            {
                                <p class="text-xs text-gray-400 italic">Aucune lettre téléversée.</p>
                            }
                        </div>

                        <div>
                            <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Remplacer / Ajouter une lettre</label>
                            <input asp-for="CoverLetterFile" type="file" accept="application/pdf" class="block w-full text-xs text-gray-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-[#001e40] file:text-white hover:file:bg-[#0061a7] file:cursor-pointer transition-all" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="flex justify-end">
                <button type="submit" class="px-8 py-3.5 rounded-xl bg-[#001e40] hover:bg-[#0061a7] text-white font-bold text-sm shadow-md transition-colors flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    <span>Enregistrer le profil</span>
                </button>
            </div>
        </form>
    </div>
</div>