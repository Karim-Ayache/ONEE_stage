@model ONEE_Stage.Models.ViewModels.ApplicationViewModel

@{
    ViewData["Title"] = "Postuler à l'offre - Portail ONEE";
}

<div class="flex items-center justify-center min-h-[calc(100vh-80px)] bg-[#faf8ff] py-12 px-4">
    <div class="max-w-xl w-full bg-white rounded-3xl shadow-sm border border-gray-100 p-8 md:p-10">

        <!-- Header & Offer Info Banner -->
        <div class="mb-8 border-b border-gray-100 pb-6">
            <div class="flex items-center gap-2 mb-3">
                <span class="px-3 py-1 rounded-full bg-[#eaedff] text-[#0061a7] font-bold text-xs uppercase tracking-wider">
                    Dépôt de candidature
                </span>
                <span class="text-xs text-gray-400 font-mono">STG-2026-@Model.OfferId</span>
            </div>

            <h1 class="text-2xl md:text-3xl font-bold text-[#001e40] break-words">@Model.OfferTitle</h1>

            <div class="flex items-center gap-2 text-xs text-[#43474f] mt-3 font-medium">
                <span class="material-symbols-outlined text-[18px] text-[#0061a7]">corporate_fare</span>
                <span>Département : <strong class="text-[#001e40]">@Model.Department</strong></span>
            </div>
        </div>

        <form asp-action="Apply" method="post" enctype="multipart/form-data" class="space-y-6">

            <!-- Global Validation Summary & TempData Error Alert -->
            <div asp-validation-summary="ModelOnly" class="text-xs font-bold text-red-600 bg-red-50 p-3 rounded-xl border border-red-100"></div>

            @if (TempData["Error"] != null)
            {
                <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-xs font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">error</span>
                    <span>@TempData["Error"]</span>
                </div>
            }

            <input type="hidden" asp-for="OfferId" />
            <input type="hidden" asp-for="OfferTitle" />
            <input type="hidden" asp-for="Department" />

            <!-- Curriculum Vitae (CV) Field -->
            <div>
                <label class="block text-xs font-bold text-[#001e40] mb-2 flex items-center justify-between">
                    <span>Curriculum Vitae (CV) <span class="text-red-500">*</span></span>
                    <span class="text-[11px] text-[#0061a7] font-semibold">Format PDF (Max : 5 Mo)</span>
                </label>

                <!-- Initial Upload Dropzone -->
                <div id="cvDropzone" class="relative border-2 border-dashed border-gray-200 hover:border-[#0061a7] rounded-2xl p-6 bg-[#f2f3ff]/50 text-center transition-colors cursor-pointer group">
                    <input type="file" id="cvInput" name="cvFile" accept="application/pdf" required class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                    <div class="flex flex-col items-center justify-center pointer-events-none">
                        <span class="material-symbols-outlined text-[32px] text-[#0061a7] group-hover:scale-110 transition-transform mb-1">upload_file</span>
                        <p class="text-xs font-bold text-[#001e40]">Cliquez ou glissez votre CV ici</p>
                        <p class="text-[11px] text-gray-400 mt-0.5">Document PDF obligatoire</p>
                    </div>
                </div>

                <!-- Selected File Display Card -->
                <div id="cvFileDisplay" class="hidden border border-emerald-200 bg-emerald-50/50 rounded-2xl p-4 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="p-2 bg-emerald-100 rounded-xl text-emerald-700">
                            <span class="material-symbols-outlined text-[24px]">picture_as_pdf</span>
                        </div>
                        <div>
                            <p id="cvFileName" class="text-xs font-bold text-[#001e40] truncate max-w-[200px] sm:max-w-[280px]">filename.pdf</p>
                            <p id="cvFileSize" class="text-[10px] font-semibold text-emerald-700 mt-0.5">0 Mo</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="previewPDF('cvInput')" class="px-3 py-1.5 bg-white hover:bg-[#001e40] text-[#001e40] hover:text-white border border-gray-200 rounded-lg text-xs font-bold transition-colors flex items-center gap-1 shadow-2xs">
                            <span class="material-symbols-outlined text-[16px]">visibility</span>
                            <span>Aperçu</span>
                        </button>
                        <button type="button" onclick="clearFile('cvInput', 'cvDropzone', 'cvFileDisplay')" class="p-1.5 text-gray-400 hover:text-red-600 rounded-lg transition-colors">
                            <span class="material-symbols-outlined text-[18px]">close</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Cover Letter Field -->
            <div>
                <label class="block text-xs font-bold text-[#001e40] mb-2 flex items-center justify-between">
                    <span>Lettre de motivation <span class="text-gray-400 font-normal">(Optionnel)</span></span>
                    <span class="text-[11px] text-gray-400">Format PDF (Max : 5 Mo)</span>
                </label>

                <!-- Initial Upload Dropzone -->
                <div id="clDropzone" class="relative border-2 border-dashed border-gray-200 hover:border-[#0061a7] rounded-2xl p-6 bg-[#f2f3ff]/50 text-center transition-colors cursor-pointer group">
                    <input type="file" id="clInput" name="coverLetterFile" accept="application/pdf" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                    <div class="flex flex-col items-center justify-center pointer-events-none">
                        <span class="material-symbols-outlined text-[32px] text-gray-400 group-hover:text-[#0061a7] group-hover:scale-110 transition-transform mb-1">description</span>
                        <p class="text-xs font-bold text-[#001e40]">Cliquez ou glissez votre lettre de motivation ici</p>
                        <p class="text-[11px] text-gray-400 mt-0.5">Document PDF optionnel</p>
                    </div>
                </div>

                <!-- Selected File Display Card -->
                <div id="clFileDisplay" class="hidden border border-emerald-200 bg-emerald-50/50 rounded-2xl p-4 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="p-2 bg-emerald-100 rounded-xl text-emerald-700">
                            <span class="material-symbols-outlined text-[24px]">description</span>
                        </div>
                        <div>
                            <p id="clFileName" class="text-xs font-bold text-[#001e40] truncate max-w-[200px] sm:max-w-[280px]">filename.pdf</p>
                            <p id="clFileSize" class="text-[10px] font-semibold text-emerald-700 mt-0.5">0 Mo</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="previewPDF('clInput')" class="px-3 py-1.5 bg-white hover:bg-[#001e40] text-[#001e40] hover:text-white border border-gray-200 rounded-lg text-xs font-bold transition-colors flex items-center gap-1 shadow-2xs">
                            <span class="material-symbols-outlined text-[16px]">visibility</span>
                            <span>Aperçu</span>
                        </button>
                        <button type="button" onclick="clearFile('clInput', 'clDropzone', 'clFileDisplay')" class="p-1.5 text-gray-400 hover:text-red-600 rounded-lg transition-colors">
                            <span class="material-symbols-outlined text-[18px]">close</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="pt-4 flex items-center justify-between border-t border-gray-100">
                <a asp-controller="Offers" asp-action="Index" class="px-5 py-3 rounded-xl text-xs font-bold text-[#43474f] hover:bg-gray-100 transition-colors inline-flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">close</span>
                    <span>Annuler</span>
                </a>
                <button type="submit" class="px-6 py-3 bg-[#001e40] hover:bg-[#0061a7] text-white font-bold text-xs rounded-xl transition-colors shadow-md flex items-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">send</span>
                    <span>Transmettre ma candidature</span>
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            setupFileHandler('cvInput', 'cvDropzone', 'cvFileDisplay', 'cvFileName', 'cvFileSize');
            setupFileHandler('clInput', 'clDropzone', 'clFileDisplay', 'clFileName', 'clFileSize');
        });

        function setupFileHandler(inputId, dropzoneId, displayId, nameId, sizeId) {
            const input = document.getElementById(inputId);
            const dropzone = document.getElementById(dropzoneId);
            const display = document.getElementById(displayId);
            const fileName = document.getElementById(nameId);
            const fileSize = document.getElementById(sizeId);

            if (input) {
                input.addEventListener('change', () => {
                    if (input.files && input.files[0]) {
                        const file = input.files[0];
                        fileName.textContent = file.name;
                        fileSize.textContent = (file.size / 1024 / 1024).toFixed(2) + ' Mo';

                        dropzone.classList.add('hidden');
                        display.classList.remove('hidden');
                    }
                });
            }
        }

        function clearFile(inputId, dropzoneId, displayId) {
            const input = document.getElementById(inputId);
            const dropzone = document.getElementById(dropzoneId);
            const display = document.getElementById(displayId);

            if (input) input.value = '';
            if (dropzone) dropzone.classList.remove('hidden');
            if (display) display.classList.add('hidden');
        }

        function previewPDF(inputId) {
            const input = document.getElementById(inputId);
            if (input && input.files && input.files[0]) {
                const fileURL = URL.createObjectURL(input.files[0]);
                window.open(fileURL, '_blank');
            }
        }
    </script>
}