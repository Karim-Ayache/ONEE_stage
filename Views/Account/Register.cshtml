@model ONEE_Stage.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Candidate Registration - ONEE Portal";
}

<div class="flex items-center justify-center min-h-[calc(100vh-80px)] bg-[#faf8ff] py-12 px-4">
    <div class="max-w-xl w-full bg-white rounded-3xl shadow-sm border border-gray-100 p-8 md:p-10">

        <!-- Header -->
        <div class="text-center mb-8">
            <span class="px-3 py-1 rounded-full bg-[#eaedff] text-[#0061a7] font-bold text-xs uppercase tracking-wider">Candidate Portal</span>
            <h1 class="text-2xl md:text-3xl font-bold text-[#001e40] mt-3">Student Registration</h1>
            <p class="text-xs text-gray-500 mt-1">Create your candidate profile to apply for ONEE internship offers.</p>
        </div>

        <form asp-action="Register" method="post" class="space-y-4">
            <div asp-validation-summary="ModelOnly" class="text-xs font-bold text-red-600 bg-red-50 p-3 rounded-xl border border-red-100"></div>

            <!-- First & Last Name Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="FirstName" class="block text-xs font-bold text-[#001e40] mb-1.5">First Name</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-[18px]">person</span>
                        <input asp-for="FirstName" class="w-full pl-9 pr-3 py-2.5 text-sm bg-[#f2f3ff] border border-transparent rounded-xl focus:bg-white focus:border-[#0061a7] focus:ring-2 focus:ring-[#0061a7]/20 outline-none transition-all" placeholder="Anass" />
                    </div>
                    <span asp-validation-for="FirstName" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="LastName" class="block text-xs font-bold text-[#001e40] mb-1.5">Last Name</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-[18px]">person</span>
                        <input asp-for="LastName" class="w-full pl-9 pr-3 py-2.5 text-sm bg-[#f2f3ff] border border-transparent rounded-xl focus:bg-white focus:border-[#0061a7] focus:ring-2 focus:ring-[#0061a7]/20 outline-none transition-all" placeholder="Benjelloun" />
                    </div>
                    <span asp-validation-for="LastName" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Contact Information Grid (Email & Phone) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Email" class="block text-xs font-bold text-[#001e40] mb-1.5">Personal Email</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-[18px]">mail</span>
                        <input asp-for="Email" class="w-full pl-9 pr-3 py-2.5 text-sm bg-[#f2f3ff] border border-transparent rounded-xl focus:bg-white focus:border-[#0061a7] focus:ring-2 focus:ring-[#0061a7]/20 outline-none transition-all" placeholder="anass.benjelloun@gmail.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Phone" class="block text-xs font-bold text-[#001e40] mb-1.5">Phone Number</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-[18px]">call</span>
                        <input asp-for="Phone" class="w-full pl-9 pr-3 py-2.5 text-sm bg-[#f2f3ff] border border-transparent rounded-xl focus:bg-white focus:border-[#0061a7] focus:ring-2 focus:ring-[#0061a7]/20 outline-none transition-all" placeholder="+212 6 00 00 00 00" />
                    </div>
                    <span asp-validation-for="Phone" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Academic Info Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="University" class="block text-xs font-bold text-[#001e40] mb-1.5">University / School</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-[18px]">school</span>
                        <input asp-for="University" class="w-full pl-9 pr-3 py-2.5 text-sm bg-[#f2f3ff] border border-transparent rounded-xl focus:bg-white focus:border-[#0061a7] focus:ring-2 focus:ring-[#0061a7]/20 outline-none transition-all" placeholder="EMI, ENSIAS, FSR..." />
                    </div>
                    <span asp-validation-for="University" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="InstitutionalEmail" class="block text-xs font-bold text-[#001e40] mb-1.5">Institutional Email</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-[18px]">badge</span>
                        <input asp-for="InstitutionalEmail" class="w-full pl-9 pr-3 py-2.5 text-sm bg-[#f2f3ff] border border-transparent rounded-xl focus:bg-white focus:border-[#0061a7] focus:ring-2 focus:ring-[#0061a7]/20 outline-none transition-all" placeholder="anass@um5.ac.ma" />
                    </div>
                    <span asp-validation-for="InstitutionalEmail" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Password Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Password" class="block text-xs font-bold text-[#001e40] mb-1.5">Password</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-[18px]">lock</span>
                        <input asp-for="Password" type="password" class="w-full pl-9 pr-3 py-2.5 text-sm bg-[#f2f3ff] border border-transparent rounded-xl focus:bg-white focus:border-[#0061a7] focus:ring-2 focus:ring-[#0061a7]/20 outline-none transition-all" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-xs font-bold text-[#001e40] mb-1.5">Confirm Password</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-[18px]">lock_reset</span>
                        <input asp-for="ConfirmPassword" type="password" class="w-full pl-9 pr-3 py-2.5 text-sm bg-[#f2f3ff] border border-transparent rounded-xl focus:bg-white focus:border-[#0061a7] focus:ring-2 focus:ring-[#0061a7]/20 outline-none transition-all" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-[11px] text-red-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="pt-2">
                <button type="submit" class="w-full py-3.5 bg-[#001e40] hover:bg-[#0061a7] text-white font-bold text-sm rounded-xl transition-colors shadow-md flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-[18px]">how_to_reg</span>
                    <span>Create Candidate Account</span>
                </button>
            </div>
        </form>

        <!-- Existing Account Link -->
        <div class="mt-6 pt-6 border-t border-gray-100 text-center">
            <p class="text-xs text-[#43474f]">
                Already have a candidate account?
                <a asp-action="Login" class="font-bold text-[#0061a7] hover:underline ml-1">Sign in here</a>
            </p>
        </div>

    </div>
</div>