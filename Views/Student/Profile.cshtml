@model ONEE_Stage.Models.Entities.Student

@{
    ViewData["Title"] = "Mon Profil Étudiant";
}

<div class="max-w-4xl mx-auto py-10 px-4">
    <div class="bg-white shadow-xl rounded-2xl overflow-hidden border border-gray-100">
        <!-- Header Banner -->
        <div class="bg-[#001e40] px-8 py-6 text-white flex items-center justify-between">
            <div>
                <h2 class="text-2xl font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined text-[28px]">badge</span> Mon Profil Étudiant
                </h2>
                <p class="text-gray-300 text-sm mt-1">Gérez vos informations personnelles et académiques au sein de l'ONEE.</p>
            </div>
            <span class="bg-blue-600/50 text-blue-200 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-blue-400/30">
                Stagiaire
            </span>
        </div>

        <!-- Form Body -->
        <form asp-action="Profile" method="post" enctype="multipart/form-data" class="p-8 space-y-6">
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- First Name -->
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Prénom</label>
                    <input type="text" value="@Model.FirstName" disabled class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-500 cursor-not-allowed" />
                </div>

                <!-- Last Name -->
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Nom</label>
                    <input type="text" value="@Model.LastName" disabled class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-500 cursor-not-allowed" />
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Email Principal</label>
                    <input type="email" value="@Model.Email" disabled class="w-full bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-500 cursor-not-allowed" />
                </div>

                <!-- Institutional Email -->
                <div>
                    <label asp-for="InstitutionalEmail" class="block text-xs font-bold text-[#001e40] uppercase tracking-wider mb-2">Email Institutionnel</label>
                    <input asp-for="InstitutionalEmail" class="w-full bg-[#faf8ff] border border-gray-200 focus:border-[#0061a7] focus:ring-2 focus:ring-[#0061a7]/20 rounded-xl px-4 py-3 text-sm outline-none transition-all" />
                </div>

                <!-- University -->
                <div>
                    <label asp-for="University" class="block text-xs font-bold text-[#001e40] uppercase tracking-wider mb-2">Université / École</label>
                    <input asp-for="University" class="w-full bg-[#faf8ff] border border-gray-200 focus:border-[#0061a7] focus:ring-2 focus:ring-[#0061a7]/20 rounded-xl px-4 py-3 text-sm outline-none transition-all" />
                </div>

                <!-- Phone Number -->
                <div>
                    <label class="block text-xs font-bold text-[#001e40] uppercase tracking-wider mb-2">Numéro de Téléphone</label>
                    <input type="text" name="phone" value="@Model.Phone" class="w-full bg-[#faf8ff] border border-gray-200 focus:border-[#0061a7] focus:ring-2 focus:ring-[#0061a7]/20 rounded-xl px-4 py-3 text-sm outline-none transition-all" />
                </div>
            </div>

            <!-- Current Documents Display -->
            <div class="pt-6 border-t border-gray-100">
                <h3 class="text-sm font-bold text-[#001e40] uppercase tracking-wider mb-4">Documents actuels</h3>

                @{
                    var docs = ViewBag.StudentDocuments as List<ONEE_Stage.Models.Entities.Document> ?? new List<ONEE_Stage.Models.Entities.Document>();
                    var cv = docs.FirstOrDefault(d => d.Type == ONEE_Stage.Models.Enums.DocumentType.CV);
                    var lm = docs.FirstOrDefault(d => d.Type == ONEE_Stage.Models.Enums.DocumentType.CoverLetter);
                }

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-4">
                    <div class="bg-white p-4 rounded-lg border">
                        <h4 class="text-xs font-bold text-gray-700 mb-2">Curriculum Vitae (CV)</h4>
                        @if (cv != null)
                        {
                            <div class="flex items-center justify-between gap-4">
                                <div>
                                    <div class="text-sm font-semibold">@cv.FileName</div>
                                    <div class="text-xs text-gray-500">Téléversé : @cv.UploadedAt.ToLocalTime().ToString("g")</div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <a target="_blank" class="text-sm text-[#0061a7] underline" href="@Url.Action("ViewDocument","Student", new { id = cv.Id })">Aperçu</a>
                                    <a class="text-sm text-[#001e40]" href="@Url.Action("DownloadDocument","Student", new { id = cv.Id })">Télécharger</a>
                                    <form asp-action="DeleteDocument" asp-controller="Student" method="post" class="inline-block">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cv.Id" />
                                        <button type="submit" class="text-sm text-red-600 ml-2" onclick="return confirm('Supprimer ce document ?');">Supprimer</button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-xs text-gray-500">Aucun CV enregistré.</div>
                        }
                    </div>

                    <div class="bg-white p-4 rounded-lg border">
                        <h4 class="text-xs font-bold text-gray-700 mb-2">Lettre de motivation</h4>
                        @if (lm != null)
                        {
                            <div class="flex items-center justify-between gap-4">
                                <div>
                                    <div class="text-sm font-semibold">@lm.FileName</div>
                                    <div class="text-xs text-gray-500">Téléversé : @lm.UploadedAt.ToLocalTime().ToString("g")</div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <a target="_blank" class="text-sm text-[#0061a7] underline" href="@Url.Action("ViewDocument","Student", new { id = lm.Id })">Aperçu</a>
                                    <a class="text-sm text-[#001e40]" href="@Url.Action("DownloadDocument","Student", new { id = lm.Id })">Télécharger</a>
                                    <form asp-action="DeleteDocument" asp-controller="Student" method="post" class="inline-block">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@lm.Id" />
                                        <button type="submit" class="text-sm text-red-600 ml-2" onclick="return confirm('Supprimer ce document ?');">Supprimer</button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-xs text-gray-500">Aucune lettre de motivation enregistrée.</div>
                        }
                    </div>
                </div>

                <!-- All documents list with delete option -->
                <div class="bg-white p-4 rounded-lg border">
                    <h4 class="text-xs font-bold text-gray-700 mb-2">Tous les documents</h4>
                    @if (docs.Any())
                    {
                        <ul class="space-y-2 text-sm">
                            @foreach (var d in docs)
                            {
                                <li class="flex items-center justify-between">
                                    <div>
                                        <span class="font-medium">@d.FileName</span>
                                        <span class="text-xs text-gray-500"> — @d.Type.ToString()</span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <a target="_blank" class="text-xs text-[#0061a7]" href="@Url.Action("ViewDocument","Student", new { id = d.Id })">Aperçu</a>
                                        <a class="text-xs text-[#001e40]" href="@Url.Action("DownloadDocument","Student", new { id = d.Id })">Télécharger</a>
                                        <form asp-action="DeleteDocument" asp-controller="Student" method="post" class="inline-block">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <button type="submit" class="text-xs text-red-600" onclick="return confirm('Supprimer ce document ?');">Supprimer</button>
                                        </form>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-xs text-gray-500">Aucun document téléversé.</div>
                    }
                </div>
            </div>

            <!-- Documents Section -->
            <div class="pt-6 border-t border-gray-100">
                <h3 class="text-sm font-bold text-[#001e40] uppercase tracking-wider mb-4"><i class="fas fa-file-alt me-2 text-[#0061a7]"></i> Documents par Défaut</h3>
                <p class="text-xs text-gray-500 mb-4">Ces documents seront automatiquement joints à vos futures candidatures (vous pourrez les modifier lors de la postulation).</p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- CV Upload -->
                    <div class="bg-[#f2f3ff] p-4 rounded-xl border border-blue-100 border-dashed">
                        <label class="block text-xs font-bold text-[#0061a7] uppercase tracking-wider mb-2">Curriculum Vitae (CV)</label>
                        @if (Model.DefaultCvDocumentId.HasValue)
                        {
                            <div class="mb-2 inline-flex items-center gap-1 bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-bold">
                                <span class="material-symbols-outlined text-[14px]">check_circle</span> CV actuel enregistré
                            </div>
                        }
                        <input type="file" name="cvFile" accept=".pdf,.doc,.docx" class="w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#0061a7] file:text-white hover:file:bg-[#001e40] transition-all cursor-pointer" />
                    </div>

                    <!-- Cover Letter Upload -->
                    <div class="bg-[#f2f3ff] p-4 rounded-xl border border-blue-100 border-dashed">
                        <label class="block text-xs font-bold text-[#0061a7] uppercase tracking-wider mb-2">Lettre de Motivation</label>
                        @if (Model.DefaultCoverLetterDocumentId.HasValue)
                        {
                            <div class="mb-2 inline-flex items-center gap-1 bg-green-100 text-green-700 px-2 py-1 rounded text-xs font-bold">
                                <span class="material-symbols-outlined text-[14px]">check_circle</span> Lettre enregistrée
                            </div>
                        }
                        <input type="file" name="coverLetterFile" accept=".pdf,.doc,.docx" class="w-full text-sm text-gray-600 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#0061a7] file:text-white hover:file:bg-[#001e40] transition-all cursor-pointer" />
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="pt-6 border-t border-gray-100 flex justify-end">
                <button type="submit" class="bg-[#003366] hover:bg-[#001e40] text-white px-6 py-3 rounded-xl text-sm font-bold shadow-sm transition-colors flex items-center gap-2 cursor-pointer">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    <span>Enregistrer le profil et les documents</span>
                </button>
            </div>
        </form>
    </div>
</div>