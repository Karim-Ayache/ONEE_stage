@model ONEE_Stage.Models.ViewModels.OfferViewModel
@using ONEE_Stage.Models.Enums

@{
    ViewData["Title"] = "Créer une offre de stage";
}

<main class="w-full bg-[#faf8ff] min-h-screen">

    <!-- ========================= -->
    <!-- BREADCRUMB -->
    <!-- ========================= -->
    <div class="w-full bg-[#f2f3ff]/70 py-3">
        <div class="max-w-[1280px] mx-auto px-4 md:px-8 flex flex-wrap items-center justify-between gap-3">
            <nav aria-label="Fil d'ariane" class="flex items-center flex-wrap gap-1 text-[13px] text-[#43474f]">
                <a asp-controller="Home" asp-action="Index" class="hover:text-[#001e40] transition-colors flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">home</span>
                    <span>Accueil</span>
                </a>
                <span class="material-symbols-outlined text-[14px] text-[#737780]">chevron_right</span>
                <a asp-action="Index" class="hover:text-[#001e40] transition-colors">Offres de Stage</a>
                <span class="material-symbols-outlined text-[14px] text-[#737780]">chevron_right</span>
                <span class="text-[#001e40] font-semibold">Créer une offre</span>
            </nav>
            <a asp-action="Index" class="inline-flex items-center gap-2 text-[12px] font-semibold text-[#0061a7] hover:text-[#001e40] py-1 px-2 rounded bg-white shadow-sm">
                <span class="material-symbols-outlined text-[16px]">arrow_back</span>
                <span>Retour aux offres</span>
            </a>
        </div>
    </div>

    <!-- ========================= -->
    <!-- HERO -->
    <!-- ========================= -->
    <section class="relative w-full bg-white overflow-hidden shadow-sm">
        <div class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-[#d2e4ff]/30 blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 left-1/3 w-80 h-80 rounded-full bg-[#cce5ff]/40 blur-3xl pointer-events-none"></div>

        <div class="relative max-w-[1280px] mx-auto px-4 md:px-8 py-8 lg:py-12">
            <div class="flex flex-col gap-4">
                <!-- Badge -->
                <div class="flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-bold uppercase tracking-wider">
                        <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                        Nouvelle offre
                    </span>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#eaedff] text-[#001e40] text-[11px] font-semibold">
                        <span class="material-symbols-outlined text-[15px] text-[#0061a7]">edit_note</span>
                        Espace RH
                    </span>
                </div>

                <!-- Title -->
                <h1 class="text-[30px] md:text-[40px] leading-tight font-bold tracking-tight text-[#001e40] max-w-4xl">
                    Créer une nouvelle offre de stage
                </h1>

                <p class="text-[14px] md:text-[16px] leading-relaxed text-[#43474f] max-w-3xl">
                    Renseignez les informations de l'offre afin de proposer une nouvelle opportunité de stage aux étudiants.
                </p>

                <!-- Meta strip -->
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 pt-2">
                    <div class="flex items-center gap-2 p-2 rounded-lg bg-[#f2f3ff]">
                        <span class="material-symbols-outlined text-[#0061a7] text-[20px]">domain</span>
                        <div class="flex flex-col">
                            <span class="text-[11px] uppercase text-[#737780]">Créateur</span>
                            <span class="text-[13px] font-semibold text-[#131b2e]">Service RH</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 p-2 rounded-lg bg-[#f2f3ff]">
                        <span class="material-symbols-outlined text-[#0061a7] text-[20px]">calendar_today</span>
                        <div class="flex flex-col">
                            <span class="text-[11px] uppercase text-[#737780]">Publication</span>
                            <span class="text-[13px] font-semibold text-[#131b2e]">Aujourd'hui</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 p-2 rounded-lg bg-[#f2f3ff]">
                        <span class="material-symbols-outlined text-[#0061a7] text-[20px]">visibility</span>
                        <div class="flex flex-col">
                            <span class="text-[11px] uppercase text-[#737780]">Visibilité</span>
                            <span class="text-[13px] font-semibold text-[#131b2e]">Portail Stages</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 p-2 rounded-lg bg-[#f2f3ff]">
                        <span class="material-symbols-outlined text-[#0061a7] text-[20px]">verified</span>
                        <div class="flex flex-col">
                            <span class="text-[11px] uppercase text-[#737780]">Statut</span>
                            <span class="text-[13px] font-semibold text-emerald-700">En préparation</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================= -->
    <!-- MAIN FORM CONTAINER -->
    <!-- ========================= -->
    <div class="max-w-[1280px] mx-auto px-4 md:px-8 py-8 lg:py-12">

        <!-- PROPER FORM TAG ADDED HERE -->
        <form asp-action="Create" method="post" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

            <!-- ================================= -->
            <!-- LEFT : FORM FIELDS -->
            <!-- ================================= -->
            <div class="lg:col-span-8 flex flex-col gap-6">

                <!-- GENERAL INFORMATION -->
                <section class="bg-white p-6 rounded-xl shadow-sm">
                    <div class="flex items-center gap-2 mb-5">
                        <span class="w-2.5 h-6 bg-[#0061a7] rounded-full"></span>
                        <h2 class="text-[20px] leading-7 font-semibold text-[#001e40]">Informations générales</h2>
                    </div>

                    <!-- TITLE -->
                    <div class="flex flex-col gap-1 mb-5">
                        <label asp-for="Title" class="text-[12px] font-semibold text-[#131b2e]">
                            Intitulé de l'offre <span class="text-red-600">*</span>
                        </label>
                        <input asp-for="Title" id="offerTitle" class="w-full h-11 px-3 rounded-lg bg-[#f2f3ff] text-[#131b2e] placeholder:text-[#737780] text-[14px] focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#0061a7] transition-all" placeholder="Ex. PFE - Développement d'une plateforme Cloud" />
                        <span asp-validation-for="Title" class="text-[11px] text-red-600"></span>
                    </div>

                    <!-- DESCRIPTION -->
                    <div class="flex flex-col gap-1 mb-5">
                        <label asp-for="Description" class="text-[12px] font-semibold text-[#131b2e]">
                            Description de la mission <span class="text-red-600">*</span>
                        </label>
                        <textarea asp-for="Description" id="offerDescription" rows="6" class="w-full px-3 py-3 rounded-lg bg-[#f2f3ff] text-[#131b2e] placeholder:text-[#737780] text-[14px] leading-relaxed resize-y focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#0061a7] transition-all" placeholder="Décrivez le contexte, les objectifs et les principales missions du stage..."></textarea>
                        <span class="text-[11px] text-[#737780]">Décrivez clairement le contexte et les objectifs de la mission proposée.</span>
                        <span asp-validation-for="Description" class="text-[11px] text-red-600"></span>
                    </div>

                    <!-- DEPARTMENT / SPECIALIZATION -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="flex flex-col gap-1">
                            <label asp-for="Department" class="text-[12px] font-semibold text-[#131b2e]">
                                Département <span class="text-red-600">*</span>
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#737780] text-[19px]">corporate_fare</span>
                                <input asp-for="Department" id="offerDepartment" class="w-full h-11 pl-10 pr-3 rounded-lg bg-[#f2f3ff] text-[14px] focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#0061a7]" placeholder="Ex. Systèmes d'Information" />
                            </div>
                            <span asp-validation-for="Department" class="text-[11px] text-red-600"></span>
                        </div>

                        <div class="flex flex-col gap-1">
                            <label asp-for="Specialization" class="text-[12px] font-semibold text-[#131b2e]">
                                Spécialité recherchée <span class="text-red-600">*</span>
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#737780] text-[19px]">school</span>
                                <input asp-for="Specialization" id="offerSpecialization" class="w-full h-11 pl-10 pr-3 rounded-lg bg-[#f2f3ff] text-[14px] focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#0061a7]" placeholder="Ex. Génie Informatique" />
                            </div>
                            <span asp-validation-for="Specialization" class="text-[11px] text-red-600"></span>
                        </div>
                    </div>
                </section>

                <!-- ================================= -->
                <!-- STAGE DETAILS -->
                <!-- ================================= -->
                <section class="bg-white p-6 rounded-xl shadow-sm">
                    <div class="flex items-center gap-2 mb-5">
                        <span class="w-2.5 h-6 bg-[#0061a7] rounded-full"></span>
                        <h2 class="text-[20px] font-semibold text-[#001e40]">Détails du stage</h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- TYPE -->
                        <div class="flex flex-col gap-1">
                            <label asp-for="Type" class="text-[12px] font-semibold text-[#131b2e]">
                                Type de stage <span class="text-red-600">*</span>
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#0061a7] text-[19px] pointer-events-none">badge</span>
                                <select asp-for="Type" id="offerType" asp-items="Html.GetEnumSelectList<InternshipType>()" class="w-full h-11 pl-10 pr-8 rounded-lg bg-[#f2f3ff] text-[14px] appearance-none focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#0061a7]">
                                    <option value="">-- Sélectionnez le type --</option>
                                </select>
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[#737780] pointer-events-none">arrow_drop_down</span>
                            </div>
                            <span asp-validation-for="Type" class="text-[11px] text-red-600"></span>
                        </div>

                        <!-- WORK MODE -->
                        <div class="flex flex-col gap-1">
                            <label asp-for="WorkMode" class="text-[12px] font-semibold text-[#131b2e]">
                                Mode de travail <span class="text-red-600">*</span>
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#0061a7] text-[19px] pointer-events-none">work</span>
                                <select asp-for="WorkMode" id="offerWorkMode" asp-items="Html.GetEnumSelectList<WorkMode>()" class="w-full h-11 pl-10 pr-8 rounded-lg bg-[#f2f3ff] text-[14px] appearance-none focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#0061a7]">
                                    <option value="">-- Sélectionnez le mode --</option>
                                </select>
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[#737780] pointer-events-none">arrow_drop_down</span>
                            </div>
                            <span asp-validation-for="WorkMode" class="text-[11px] text-red-600"></span>
                        </div>

                        <!-- WORK PACE -->
                        <div class="flex flex-col gap-1">
                            <label asp-for="WorkPace" class="text-[12px] font-semibold text-[#131b2e]">Rythme de travail</label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#0061a7] text-[19px] pointer-events-none">schedule</span>
                                <select asp-for="WorkPace" id="offerWorkPace" asp-items="Html.GetEnumSelectList<WorkPace>()" class="w-full h-11 pl-10 pr-8 rounded-lg bg-[#f2f3ff] text-[14px] appearance-none focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#0061a7]">
                                    <option value="">-- Sélectionnez le rythme --</option>
                                </select>
                                <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-[#737780] pointer-events-none">arrow_drop_down</span>
                            </div>
                            <span asp-validation-for="WorkPace" class="text-[11px] text-red-600"></span>
                        </div>

                        <!-- PERIOD -->
                        <div class="flex flex-col gap-1">
                            <label asp-for="Periode" class="text-[12px] font-semibold text-[#131b2e]">
                                Durée / Période <span class="text-red-600">*</span>
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#0061a7] text-[19px]">timer</span>
                                <input asp-for="Periode" id="offerPeriod" class="w-full h-11 pl-10 pr-3 rounded-lg bg-[#f2f3ff] text-[14px] focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#0061a7]" placeholder="Ex. 4 à 6 mois" />
                            </div>
                            <span asp-validation-for="Periode" class="text-[11px] text-red-600"></span>
                        </div>

                        <!-- POSITIONS -->
                        <div class="flex flex-col gap-1">
                            <label asp-for="AvailablePositions" class="text-[12px] font-semibold text-[#131b2e]">
                                Postes disponibles <span class="text-red-600">*</span>
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#0061a7] text-[19px]">groups</span>
                                <input asp-for="AvailablePositions" id="offerPositions" type="number" min="1" class="w-full h-11 pl-10 pr-3 rounded-lg bg-[#f2f3ff] text-[14px] focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#0061a7]" placeholder="Ex. 2" />
                            </div>
                            <span asp-validation-for="AvailablePositions" class="text-[11px] text-red-600"></span>
                        </div>

                        <!-- DEADLINE -->
                        <div class="flex flex-col gap-1">
                            <label asp-for="Deadline" class="text-[12px] font-semibold text-[#131b2e]">
                                Date limite de candidature <span class="text-red-600">*</span>
                            </label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[#0061a7] text-[19px]">event</span>
                                <input asp-for="Deadline" id="offerDeadline" type="date" class="w-full h-11 pl-10 pr-3 rounded-lg bg-[#f2f3ff] text-[14px] focus:outline-none focus:bg-white focus:ring-2 focus:ring-[#0061a7]" />
                            </div>
                            <span asp-validation-for="Deadline" class="text-[11px] text-red-600"></span>
                        </div>
                    </div>
                </section>

                <!-- ================================= -->
                <!-- PUBLICATION -->
                <!-- ================================= -->
                <section class="bg-white p-6 rounded-xl shadow-sm">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="w-2.5 h-6 bg-[#0061a7] rounded-full"></span>
                        <h2 class="text-[20px] font-semibold text-[#001e40]">Publication de l'offre</h2>
                    </div>

                    <div class="flex items-start gap-3 p-3 rounded-lg bg-[#f2f3ff]">
                        <span class="material-symbols-outlined text-[#0061a7] text-[20px]">info</span>
                        <p class="text-[13px] leading-relaxed text-[#43474f]">
                            Vérifiez attentivement les informations renseignées avant de créer l'offre. Elle sera ensuite disponible sur le portail des stages ONEE.
                        </p>
                    </div>

                    <!-- ACTIONS -->
                    <div class="flex flex-col-reverse sm:flex-row items-stretch sm:items-center justify-end gap-2 mt-5">
                        <a asp-action="Index" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-[13px] font-semibold text-[#43474f] hover:bg-[#f2f3ff] transition-colors">
                            <span class="material-symbols-outlined text-[18px]">close</span> Annuler
                        </a>
                        <!-- Added standard form submit here as well in case they click it here -->
                        <button type="submit" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-[#0061a7] hover:bg-[#001e40] text-white text-[13px] font-semibold shadow-md transition-all">
                            <span class="material-symbols-outlined text-[18px]">publish</span> Créer l'offre
                        </button>
                    </div>
                </section>
            </div>

            <!-- ================================= -->
            <!-- RIGHT : PREVIEW -->
            <!-- ================================= -->
            <aside class="lg:col-span-4 flex flex-col gap-6 lg:sticky lg:top-24">

                <!-- PREVIEW CARD -->
                <div class="bg-white p-6 rounded-xl shadow-md">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-[16px] font-bold text-[#001e40]">Aperçu de l'offre</span>
                        <span class="px-2 py-1 rounded bg-[#eaedff] text-[#0061a7] text-[10px] font-bold">BROUILLON</span>
                    </div>

                    <!-- Preview hero -->
                    <div class="relative w-full min-h-[145px] rounded-lg overflow-hidden bg-[#001e40] p-4 flex flex-col justify-end">
                        <div class="absolute -right-8 -top-8 w-32 h-32 rounded-full border border-white/10"></div>
                        <div class="absolute right-6 top-6 w-16 h-16 rounded-full border border-white/10"></div>
                        <span class="relative text-[10px] uppercase tracking-widest text-[#54a7ff] font-bold">Nouvelle offre</span>
                        <h3 id="previewTitle" class="relative text-[17px] font-bold text-white leading-snug mt-1">Intitulé de l'offre</h3>
                    </div>

                    <!-- Preview specs -->
                    <div class="flex flex-col gap-1 mt-4">
                        <div class="flex items-center justify-between py-2 border-b border-[#eaedff]">
                            <span class="text-[12px] text-[#43474f] flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[16px] text-[#737780]">corporate_fare</span> Département
                            </span>
                            <span id="previewDepartment" class="text-[12px] font-semibold text-[#131b2e] text-right max-w-[55%]">À définir</span>
                        </div>

                        <div class="flex items-center justify-between py-2 border-b border-[#eaedff]">
                            <span class="text-[12px] text-[#43474f] flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[16px] text-[#737780]">school</span> Spécialité
                            </span>
                            <span id="previewSpecialization" class="text-[12px] font-semibold text-[#131b2e] text-right max-w-[55%]">À définir</span>
                        </div>

                        <div class="flex items-center justify-between py-2 border-b border-[#eaedff]">
                            <span class="text-[12px] text-[#43474f] flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[16px] text-[#737780]">badge</span> Type
                            </span>
                            <span id="previewType" class="text-[12px] font-semibold text-[#131b2e] text-right">À définir</span>
                        </div>

                        <div class="flex items-center justify-between py-2 border-b border-[#eaedff]">
                            <span class="text-[12px] text-[#43474f] flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[16px] text-[#737780]">schedule</span> Durée
                            </span>
                            <span id="previewPeriod" class="text-[12px] font-semibold text-[#131b2e]">À définir</span>
                        </div>

                        <div class="flex items-center justify-between py-2 border-b border-[#eaedff]">
                            <span class="text-[12px] text-[#43474f] flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[16px] text-[#737780]">groups</span> Postes
                            </span>
                            <span id="previewPositions" class="text-[12px] font-semibold text-[#131b2e]">À définir</span>
                        </div>

                        <div class="flex items-center justify-between py-2">
                            <span class="text-[12px] text-[#43474f] flex items-center gap-1.5">
                                <span class="material-symbols-outlined text-[16px] text-[#737780]">event</span> Date limite
                            </span>
                            <span id="previewDeadline" class="text-[12px] font-semibold text-red-600">À définir</span>
                        </div>
                    </div>

                    <!-- FIXED: Standard form submit button instead of javascript hack -->
                    <button type="submit" class="w-full mt-4 py-2.5 px-4 bg-[#0061a7] hover:bg-[#001e40] text-white rounded-lg text-[13px] font-semibold flex items-center justify-center gap-2 shadow-md transition-colors">
                        <span class="material-symbols-outlined text-[19px]">add_circle</span> Créer cette offre
                    </button>
                </div>

                <!-- TIPS -->
                <div class="bg-[#f2f3ff] p-4 rounded-xl">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="material-symbols-outlined text-[#0061a7]">lightbulb</span>
                        <h3 class="text-[16px] font-bold text-[#001e40]">Conseils de rédaction</h3>
                    </div>
                    <ul class="flex flex-col gap-2 text-[12px] text-[#43474f]">
                        <li class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-[#0061a7] text-[16px]">check_circle</span>
                            <span>Utilisez un intitulé précis et facilement compréhensible.</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-[#0061a7] text-[16px]">check_circle</span>
                            <span>Décrivez clairement le contexte et les missions du stage.</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="material-symbols-outlined text-[#0061a7] text-[16px]">check_circle</span>
                            <span>Vérifiez la date limite avant publication.</span>
                        </li>
                    </ul>
                </div>

                <!-- INFORMATION -->
                <div class="bg-white p-4 rounded-xl shadow-sm">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="material-symbols-outlined text-[#0061a7]">contact_support</span>
                        <h3 class="text-[16px] font-bold text-[#001e40]">Assistance RH</h3>
                    </div>
                    <p class="text-[12px] leading-relaxed text-[#43474f]">
                        Vérifiez que toutes les informations nécessaires à l'évaluation de l'offre sont correctement renseignées avant sa publication.
                    </p>
                </div>
            </aside>
        </form>
    </div>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        /*
         * ==========================================
         * LIVE OFFER PREVIEW
         * ==========================================
         */
        function bindPreview(inputId, previewId, fallback) {
            const input = document.getElementById(inputId);
            const preview = document.getElementById(previewId);

            if (!input || !preview) return;

            function update() {
                const value = input.value.trim();
                preview.textContent = value.length > 0 ? value : fallback;
            }

            input.addEventListener("input", update);
            input.addEventListener("change", update);
            update();
        }

        bindPreview("offerTitle", "previewTitle", "Intitulé de l'offre");
        bindPreview("offerDepartment", "previewDepartment", "À définir");
        bindPreview("offerSpecialization", "previewSpecialization", "À définir");
        bindPreview("offerPeriod", "previewPeriod", "À définir");
        bindPreview("offerPositions", "previewPositions", "À définir");

        /*
         * ==========================================
         * SELECT PREVIEWS
         * ==========================================
         */
        function bindSelectPreview(selectId, previewId) {
            const select = document.getElementById(selectId);
            const preview = document.getElementById(previewId);

            if (!select || !preview) return;

            function update() {
                if (!select.value) {
                    preview.textContent = "À définir";
                    return;
                }
                const option = select.options[select.selectedIndex];
                preview.textContent = option.textContent.trim();
            }

            select.addEventListener("change", update);
            update();
        }

        bindSelectPreview("offerType", "previewType");

        /*
         * ==========================================
         * DEADLINE PREVIEW
         * ==========================================
         */
        const deadline = document.getElementById("offerDeadline");
        const previewDeadline = document.getElementById("previewDeadline");

        if (deadline && previewDeadline) {
            function updateDeadline() {
                if (!deadline.value) {
                    previewDeadline.textContent = "À définir";
                    return;
                }
                const date = new Date(deadline.value + "T00:00:00");
                previewDeadline.textContent = date.toLocaleDateString(
                    "fr-FR",
                    { day: "2-digit", month: "short", year: "numeric" }
                );
            }
            deadline.addEventListener("change", updateDeadline);
            updateDeadline();
        }
    </script>
}