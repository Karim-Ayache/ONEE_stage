@model ONEE_Stage.Models.ViewModels.HomeViewModel
@using ONEE_Stage.Models.Enums

@{
    ViewData["Title"] = "Accueil - Plateforme de Gestion des Stages ONEE";
}

<!-- Hero Banner -->
<div class="bg-primary text-white py-5 mb-5 rounded shadow-sm">
    <div class="container text-center">
        <h1 class="display-4 fw-bold mb-3">Plateforme de Gestion des Stages ONEE</h1>
        <p class="lead mb-4">
            Découvrez nos opportunités de stage au sein de l'Office National de l'Électricité et de l'Eau Potable.
        </p>
        <a asp-controller="Offers" asp-action="Index" class="btn btn-light btn-lg px-4 fw-bold text-primary">
            Explorer Toutes les Offres (@Model.TotalOpenOffers)
        </a>
    </div>
</div>

<!-- Opportunities Grid -->
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Offres de Stage Disponibles</h2>
            <p class="text-muted mb-0">Postulez directement aux opportunités actuellement ouvertes.</p>
        </div>
        <a asp-controller="Offers" asp-action="Index" class="btn btn-outline-primary">
            Voir Tout &rarr;
        </a>
    </div>

    @if (!Model.FeaturedOffers.Any())
    {
        <div class="alert alert-info text-center py-4" role="alert">
            Aucune offre de stage n'est disponible pour le moment. Veuillez revenir ultérieurement.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var offer in Model.FeaturedOffers)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-secondary">@offer.Type</span>
                                <span class="badge bg-info text-dark">@offer.WorkMode</span>
                            </div>

                            <h5 class="card-title fw-bold text-dark mb-2">@offer.Title</h5>
                            <p class="text-muted small mb-2">
                                <strong>Département :</strong> @offer.Department
                            </p>

                            <ul class="list-unstyled small text-secondary mt-auto mb-4">
                                <li class="mb-1">
                                    <strong>Durée :</strong> @(string.IsNullOrEmpty(offer.Periode) ? "Non spécifiée" : offer.Periode)
                                </li>
                                <li class="mb-1">
                                    <strong>Postes dispo :</strong> @offer.AvailablePositions
                                </li>
                                <li>
                                    <strong>Date limite :</strong> @offer.Deadline.ToString("dd/MM/yyyy")
                                </li>
                            </ul>

                            <div class="d-grid gap-2">
                                <a asp-controller="Applications" asp-action="Apply" asp-route-offerId="@offer.Id" class="btn btn-success fw-bold">
                                    Postuler
                                </a>
                                <a asp-controller="Offers" asp-action="Details" asp-route-id="@offer.Id" class="btn btn-outline-secondary btn-sm">
                                    Voir Détails
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>